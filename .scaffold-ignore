# ============================================================
# .scaffold-ignore
# new-ssf-project.ps1 이 새 프로젝트를 생성할 때
# 복사에서 제외할 항목을 정의합니다.
#
# 형식:
#   directory/     이름이 정확히 일치하는 디렉토리를 제외 (재귀 전체)
#   prefix*/       지정 접두어로 시작하는 디렉토리를 제외
#   *.ext          특정 확장자를 가진 파일을 제외
#   filename.ext   특정 파일명을 제외
#   # 주석         이 줄은 무시됩니다
#   빈 줄          무시됩니다
#
# ※ 이 파일 자체는 새 프로젝트에 복사됩니다.
# ============================================================


# ── VCS / 환경별 설정 ──────────────────────────────────────
.git/
.github/

# ── 빌드 산출물 ──────────────────────────────────────────────
target/
build/
out/
dist/
make_project/

# ── 내장 런타임 (접두어 매칭) ────────────────────────────────
tomcat.*/

# ── 의존성 ──────────────────────────────────────────────────
node_modules/

# ── 컴파일 산출물 (파일 패턴) ────────────────────────────────
*.class

# ── 로그 파일 ────────────────────────────────────────────────
*.log

# ── IDE 임시 파일 ────────────────────────────────────────────
*.tmp
Thumbs.db
.DS_Store

# ── 아래 항목은 필요에 따라 주석 해제하세요 ──────────────────

# IDE 프로젝트 설정 제외 (IDE를 공유하지 않을 경우)
